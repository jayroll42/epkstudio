{
  "name": "EPK Studio",
  "short_name": "EPK Studio",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111317",
  "theme_color": "#1a1d23",
  "description": "Build an electronic press kit, cut 1:30 snippets, and send Hit Me Up files.",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-hitmeup": [
          ".hitmeup"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            ".hitmeup",
            ".zip",
            "application/zip",
            "application/octet-stream",
            "audio/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Hit Me Up",
      "url": "./#hitmeup"
    },
    {
      "name": "Snippets",
      "url": "./#snippets"
    }
  ]
}